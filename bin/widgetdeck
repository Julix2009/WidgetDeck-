#!/bin/sh
# WidgetDeck launcher (Quickshell / QML).
# Finds its QML directory in this order:  $WIDGETDECK_QML  ->  ~/.config/quickshell/widgetdeck  ->  /usr/share/widgetdeck/qml  ->  ./qml next to this script (a git clone).

find_qml() {
    if [ -n "${WIDGETDECK_QML:-}" ] && [ -f "$WIDGETDECK_QML/shell.qml" ]; then printf '%s' "$WIDGETDECK_QML"; return 0; fi
    cfg="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/widgetdeck"
    here="$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)"
    for d in "$cfg" "/usr/share/widgetdeck/qml" "$here/../qml" "$here/../share/widgetdeck/qml"; do
        if [ -f "$d/shell.qml" ]; then (cd "$d" && pwd -P); return 0; fi
    done
    return 1
}
QML="$(find_qml)" || { echo "widgetdeck: cannot find the QML files (looked in ~/.config/quickshell/widgetdeck, /usr/share/widgetdeck/qml). Run ./install.sh first." >&2; exit 1; }
VERSION="$(tr -d '[:space:]' < "$QML/VERSION" 2>/dev/null || true)"; VERSION="${VERSION:-unknown}"
QS="quickshell -p $QML"
CONF="${WIDGETDECK_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/widgetdeck}"

running() { $QS ipc call widgetdeck ping >/dev/null 2>&1; }
ensure() {
    running && return 0
    # shellcheck disable=SC2086
    setsid $QS >/dev/null 2>&1 &
    i=0
    while [ "$i" -lt 60 ]; do running && return 0; sleep 0.2; i=$((i + 1)); done
    echo "widgetdeck: Quickshell did not start (see: widgetdeck log)" >&2
    return 1
}

doctor() {
    d="$(dirname "$0")/widgetdeck-doctor"
    if [ -x "$d" ]; then exec "$d" "$@"; fi
    if command -v widgetdeck-doctor >/dev/null 2>&1; then exec widgetdeck-doctor "$@"; fi
    echo "widgetdeck: widgetdeck-doctor is not installed (run ./install.sh)" >&2; return 1
}

# module <widgets|builder|bar|notifications> <on|off>: edits config.json (the running shell picks it up at once)
module() {
    case "$1" in widgets|builder|bar|notifications) ;; *) echo "usage: widgetdeck module <widgets|builder|bar|notifications> <on|off>" >&2; return 1 ;; esac
    case "$2" in on) v=true ;; off) v=false ;; *) echo "usage: widgetdeck module $1 <on|off>" >&2; return 1 ;; esac
    command -v jq >/dev/null 2>&1 || { echo "widgetdeck: jq is needed" >&2; return 1; }
    f="$CONF/config.json"; mkdir -p "$CONF"; [ -f "$f" ] || echo '{}' > "$f"
    t="$(mktemp "$f.XXXXXX")" && jq --arg m "$1" --argjson v "$v" '.modules[$m] = $v' "$f" > "$t" && mv "$t" "$f" && echo "module $1: $2"
}

case "${1:-builder}" in
    daemon)   if running; then echo "widgetdeck: already running" >&2; exit 0; fi; exec $QS ;;
    builder)  ensure && exec $QS ipc call widgetdeck openBuilder ;;
    toggle)   ensure && exec $QS ipc call widgetdeck toggleBuilder ;;
    close)    exec $QS ipc call widgetdeck closeBuilder ;;
    stop)     exec $QS kill ;;
    restart)  $QS kill >/dev/null 2>&1; sleep 0.5; setsid $QS >/dev/null 2>&1 & ;;
    status)   running ;;
    log)      exec $QS log ;;
    config)   echo "$CONF/widgets.json" ;;
    doctor)   shift; doctor "$@" ;;
    module)   shift; module "$@" ;;
    wizard)   ensure && exec $QS ipc call widgetdeck wizard ;;
    version|--version) echo "widgetdeck $VERSION" ;;
    ipc)      shift; exec $QS ipc call widgetdeck "$@" ;;
    *)  cat <<USAGE
widgetdeck <command>
  daemon     start the desktop widgets (runs in the foreground, used for autostart)
  builder    open the visual builder (starts the daemon if needed)
  toggle     open / close the builder (= edit mode: grid, guides, align)
  close      close the builder
  stop | restart | log
  status     exit code 0 when the daemon is running
  config     print the path of widgets.json
  doctor     check the whole setup (same as widgetdeck-doctor)
  module <name> on|off   switch a module (widgets builder bar notifications)
  wizard     show the first-run assistant again
  ipc <fn>   raw IPC call (ping, list, select <id>, style|setProp <id> <key> <json>, builderGlass <mode>, ...)
USAGE
        ;;
esac
